    },
    {
      "name": "Parameterization",
      "description": "Parameterization Management"
    },
    {
      "name": "EmailAccessMapping",
      "description": "Mapeamentos email → permissões para sistemas externos com token Keycloak sem sessão IRN (docs/SPEC_EMAIL_ACCESS_MAPPING.md). Exige JWT com STUDIO_EMAIL_ACCESS_MAPPINGS:<acao> e cookie de sessão IRN, ou super-admin; um token mapeado ou uma chave M2M recebem 403."
    }
  ],
  "paths": {
    "/email-access-mappings/{id}": {
      "put": {
        "tags": [
          "EmailAccessMapping"
        ],
        "summary": "Editar mapeamento",
        "description": "Substitui permissões, descrição, notas e expiração por inteiro. O email nunca muda: para outro endereço cria-se outro mapeamento. Só mapeamentos activos. Exige STUDIO_EMAIL_ACCESS_MAPPINGS:editar.",
        "operationId": "update",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Id do mapeamento",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailAccessMappingRequestDTO"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Mapeamento actualizado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "$ref": "#/components/schemas/EmailAccessMappingDTO"
                }
              }
            }
          },
          "400": {
            "description": "Mapeamento revogado ou inexistente, lista vazia ou permissão inválida",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "error": "invalid permission 'ROLE_DEPT_IGRP.superadmin': expected MODULE:action (roles are not allowed)"
                }
              }
            }
          },
          "403": {
            "description": "Sem a permissão, sem sessão IRN, token mapeado ou chave M2M"
          }
        }
      },
      "delete": {
        "tags": [
          "EmailAccessMapping"
        ],
        "summary": "Revogar mapeamento",
        "description": "Revogação soft (active=false, revokedBy/At), efectiva no pedido seguinte do sistema externo; sem undo. A linha fica para auditoria e o email pode voltar a ser mapeado. Exige STUDIO_EMAIL_ACCESS_MAPPINGS:eliminar.",
        "operationId": "revoke",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Id do mapeamento",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Revogado"
          },
          "400": {
            "description": "Id inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "error": "invalid permission 'ROLE_DEPT_IGRP.superadmin': expected MODULE:action (roles are not allowed)"
                }
              }
            }
          },
          "403": {
            "description": "Sem a permissão, sem sessão IRN, token mapeado ou chave M2M"
          }
        }
      }
    },
