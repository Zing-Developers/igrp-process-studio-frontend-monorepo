    "/email-access-mappings": {
      "get": {
        "tags": [
          "EmailAccessMapping"
        ],
        "summary": "Listar mapeamentos",
        "description": "Todos os mapeamentos, revogados incluídos, com o trio de auditoria (criado, alterado, revogado por). Estado: active=false → revogado; expiresAt no passado → expirado. Exige STUDIO_EMAIL_ACCESS_MAPPINGS:visualizar.",
        "operationId": "list_1",
        "responses": {
          "200": {
            "description": "Lista de mapeamentos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "$ref": "#/components/schemas/EmailAccessMappingDTO"
                }
              }
            }
          },
          "403": {
            "description": "Sem a permissão, sem sessão IRN, token mapeado ou chave M2M"
          }
        }
      },
      "post": {
        "tags": [
          "EmailAccessMapping"
        ],
        "summary": "Criar mapeamento email → permissões",
        "description": "Concede ao portador de um token Keycloak cujo claim email bate (guardado em minúsculas) as permissões MODULO:acao indicadas, para pedidos sem sessão IRN. Uma linha activa por email. Exige STUDIO_EMAIL_ACCESS_MAPPINGS:criar.",
        "operationId": "create_1",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailAccessMappingRequestDTO"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Mapeamento activo",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "$ref": "#/components/schemas/EmailAccessMappingDTO"
                }
              }
            }
          },
          "400": {
            "description": "Email inválido, lista de permissões vazia, permissão fora de MODULO:acao (ROLE_*/GROUP_* rejeitados) ou email já com mapeamento activo",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "error": "invalid permission 'ROLE_DEPT_IGRP.superadmin': expected MODULE:action (roles are not allowed)"
                }
              }
            }
          },
          "403": {
            "description": "Sem a permissão, sem sessão IRN, token mapeado ou chave M2M"
          }
        }
      }
    },
