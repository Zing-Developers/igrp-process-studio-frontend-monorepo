{
  "name": "@irn/framework-process-studio-client",
  "version": "0.0.1-beta.19",
  "type": "module",
  "description": "IGRP Process Studio Frontend | Client",
  "keywords": [
    "igrp",
    "process",
    "studio",
    "frontend",
    "client"
  ],
  "author": "IGRP Team",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsc --watch",
    "build": "rimraf dist && rimraf tsconfig.tsbuildinfo && pnpm format && tsc -b",
    "test": "tsc -b && node --test tests/*.test.mjs",
    "clean": "rimraf dist && rimraf tsconfig.tsbuildinfo",
    "format": "prettier --write .",
    "release": "pnpm build && pnpm publish --registry=https://nexus-1.zingaistudio.com/repository/npm-repo/ --tag latest"
  },
  "dependencies": {
    "@irn/framework-process-studio-types": "0.0.1-beta.20"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "next-auth": "^4.24.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.x.x"
  }
}
