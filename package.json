{
  "name": "@igrp/process-studio-frontend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev:demo": "pnpm --filter @igrp/studio-demo dev",
    "build:types": "pnpm --filter @irn/framework-process-studio-types build",
    "build:client": "pnpm --filter @irn/framework-process-studio-client build",
    "build:studio": "pnpm --filter @igrp/studio-demo build",
    "build:bpmn-editor": "pnpm --filter @irn/framework-process-studio-bpmn-editor build",
    "build:all": "pnpm build:types && pnpm build:bpmn-editor  && pnpm build:client",
    "build": "pnpm build:all",
    "dev:types": "pnpm --filter @irn/framework-process-studio-types dev",
    "dev:studio": "pnpm --filter @igrp/studio-demo dev",
    "dev:bpmn-editor": "pnpm --filter @irn/framework-process-studio-bpmn-editor dev",
    "dev:client": "pnpm --filter @irn/framework-process-studio-client dev",
    "clean": "pnpm --filter @irn/framework-process-studio-types clean && pnpm --filter @igrp/studio-demo clean && pnpm --filter @irn/framework-process-studio-bpmn-editor clean",
    "clean:all": "pnpm -r exec rm -rf dist node_modules && pnpm install",
    "demo:test": "pnpm --filter @igrp/studio-demo test",
    "release:types": "pnpm --filter @irn/framework-process-studio-types release",
    "release:client": "pnpm --filter @irn/framework-process-studio-client release",
    "release:bpmn-editor": "pnpm --filter @irn/framework-process-studio-bpmn-editor release",
    "release:all": "pnpm release:types && pnpm release:client && pnpm release:bpmn-editor",
    "release": "pnpm release:all"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@vitest/coverage-v8": "^1.0.0",
    "happy-dom": "^12.10.3",
    "typescript": "^5.2.2",
    "vitest": "^1.0.0"
  }
}
